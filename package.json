{
	"name": "acta-diurna",
	"private": true,
	"version": "0.15.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:multi": "playwright test --config=playwright.multi.config.ts",
		"test:e2e:build": "vite build && playwright test",
		"test:setup": "playwright install chromium",
		"test": "vitest run",
		"schema:export": "node scripts/export-schema.ts",
		"reader:budget": "node scripts/reader-bundle-size.ts",
		"auth:hash": "node scripts/hash-password.ts",
		"smtp:test": "node scripts/smtp-test.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.3",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.60.0",
		"@sveltejs/adapter-node": "5.5.4",
		"@sveltejs/kit": "2.64.0",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@testcontainers/postgresql": "12.0.1",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.1.8",
		"@types/node": "24.13.2",
		"@types/nodemailer": "8.0.1",
		"@types/pg": "8.20.0",
		"@vitest/browser-playwright": "4.1.8",
		"drizzle-kit": "0.31.10",
		"eslint": "10.4.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.19.0",
		"globals": "17.6.0",
		"playwright": "1.60.0",
		"prettier": "3.8.4",
		"prettier-plugin-svelte": "4.1.0",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"testcontainers": "12.0.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.0",
		"vite": "8.0.16",
		"vitest": "4.1.8",
		"vitest-browser-svelte": "2.1.1"
	},
	"dependencies": {
		"@fontsource/cinzel": "5.2.8",
		"@fontsource/inter": "5.2.8",
		"@fontsource/source-serif-4": "5.2.9",
		"@modelcontextprotocol/sdk": "1.29.0",
		"argon2": "0.44.0",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"drizzle-orm": "0.45.2",
		"nodemailer": "8.0.11",
		"pg": "8.21.0",
		"pino": "10.3.1",
		"zod": "4.4.3"
	}
}
